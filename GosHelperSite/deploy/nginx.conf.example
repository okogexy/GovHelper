server {
    listen 80;
    server_name govhelper.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name govhelper.example.com;
    root /var/www/govhelper/public;
    index index.php;
    client_max_body_size 20m;

    ssl_certificate /etc/letsencrypt/live/govhelper.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/govhelper.example.com/privkey.pem;
    add_header X-Content-Type-Options nosniff always;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ /\.(?!well-known).* { deny all; }
}
